# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# For webhook mode (production): set your public HTTPS URL
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com
# TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database

# For Docker Compose (uses internal service name):
# DATABASE_URL=postgresql+asyncpg://amhabingo:amhabingo_secret@postgres:5432/amhabingo

POSTGRES_USER=amhabingo
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=amhabingo

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=memory://

# With password (Docker Compose):
# REDIS_URL=redis://:redis_secret@redis:6379/0
REDIS_PASSWORD=change_this_password

# ── Admin Settings ──────────────────────────────────────────
# Comma-separated list of admin Telegram User IDs
ADMIN_TELEGRAM_IDS=[YOUR_TELEGRAM_ID]

# ── Business Rules ───────────────────────────────────────────
TELEBIRR_RECEIVER_NUMBER=0909425014
SUPPORT_CHANNEL_URL=https://t.me/your_support_channel
BOT_USERNAME=your_bot_username

MIN_DEPOSIT_AMOUNT=10.0
MIN_WITHDRAWAL_AMOUNT=50.0
MIN_TRANSFER_AMOUNT=10.0
MAX_WITHDRAWAL_AMOUNT=50000.0
MAX_TRANSFER_AMOUNT=50000.0

# ── App Settings ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# ── Mini App (leave empty until Mini App is ready) ───────────
# MINI_APP_URL=https://your-mini-app-url.com
